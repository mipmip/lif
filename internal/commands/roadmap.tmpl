{{- define "beanLine" -}}
- {{typeBadge .}} {{.Title}} {{beanRef .}}{{tagLine . "  "}}
{{end -}}

{{- define "featureGroup"}}
#### {{typeLabel .Feature.Type}}: {{.Feature.Title}} {{beanRef .Feature}}{{tagLine .Feature ""}}
{{with firstParagraph .Feature.Body}}
> {{.}}
{{end -}}
{{if .Items}}
{{range .Items}}{{template "beanLine" .}}{{end}}
{{- end}}
{{- end -}}

{{- define "epicGroup"}}
### {{typeLabel .Epic.Type}}: {{.Epic.Title}} {{beanRef .Epic}}{{tagLine .Epic ""}}
{{with firstParagraph .Epic.Body}}
> {{.}}
{{end -}}
{{if .Items}}
{{range .Items}}{{template "beanLine" .}}{{end}}
{{- end}}
{{- range .Features}}{{template "featureGroup" .}}{{end}}
{{- end -}}

{{- define "containerGroup"}}
{{- if .Epic}}{{template "epicGroup" .Epic}}{{else}}{{template "featureGroup" .Feature}}{{end}}
{{- end -}}

# Roadmap
{{if .Root}}
{{- with .Root.Epic}}{{template "epicGroup" .}}{{end}}
{{- with .Root.Feature}}{{template "featureGroup" .}}{{end}}
{{- else}}
{{- range .Milestones}}
## {{typeLabel .Milestone.Type}}: {{.Milestone.Title}} {{beanRef .Milestone}}{{tagLine .Milestone ""}}
{{with firstParagraph .Milestone.Body}}
> {{.}}
{{end -}}
{{- range .Containers}}{{template "containerGroup" .}}{{end}}
{{- if .Other}}
{{- if .Containers}}
### Miscellaneous
{{end}}
{{range .Other}}{{template "beanLine" .}}{{end}}
{{- end}}
{{- end}}
{{- if .Unscheduled}}
{{- if len $.Milestones}}
## Unscheduled
{{end}}
{{- range .Unscheduled.Containers}}{{template "containerGroup" .}}{{end}}
{{- if .Unscheduled.Other}}
{{- if .Unscheduled.Containers}}
### Miscellaneous
{{end}}
{{range .Unscheduled.Other}}{{template "beanLine" .}}{{end}}
{{- end}}
{{- end}}
{{- end}}
